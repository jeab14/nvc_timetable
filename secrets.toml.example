# คัดลอกเป็น .streamlit/secrets.toml (เครื่องพัฒนา) หรือวางในหน้า Secrets ของ Streamlit Cloud
# ห้าม commit ไฟล์ secrets.toml ที่มีรหัสผ่านจริงขึ้น GitHub

# PostgreSQL สำหรับใช้งานจริง (เช่น Neon, Supabase, Aiven, หรือเซิร์ฟเวอร์ของวิทยาลัย)
DATABASE_URL = "postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
